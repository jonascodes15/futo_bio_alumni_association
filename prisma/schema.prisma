generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AlumniCensus {
  id                     String   @id @default(cuid())
  fullName               String
  gradYear               Int
  email                  String   @unique
  phone                  String
  currentCity            String
  currentCountry         String
  industrySector         String
  currentRole            String?
  company                String?
  interestedInMentorship Boolean  @default(false)
  createdAt              DateTime @default(now())

  @@index([gradYear])
  @@index([industrySector])
  @@index([currentCountry])
}

enum FeedbackType {
  SUGGESTION
  NEWSLETTER_SUBSCRIBE
  INQUIRY
}

model FeedbackMessage {
  id        String       @id @default(cuid())
  fullName  String
  email     String
  type      FeedbackType
  message   String       @db.Text
  isRead    Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([isRead])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
