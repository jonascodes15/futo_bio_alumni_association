# Neon Postgres (use the pooled connection string here)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Neon direct (non-pooled) connection string, used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Resend (https://resend.com)
RESEND_API_KEY="re_xxxxxxxxx"
# Verified sender, e.g. "FUTO Bio Alumni <noreply@yourdomain.org>". Defaults to Resend's sandbox sender.
EMAIL_FROM="FUTO Bio Alumni <onboarding@resend.dev>"

# Session signing secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="change-me"

# Admin credentials (used for login; also seeded into AdminUser by `npm run db:seed`)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-strong-password"

# Public WhatsApp community invite link
NEXT_PUBLIC_WHATSAPP_LINK="https://chat.whatsapp.com/your-invite-code"
